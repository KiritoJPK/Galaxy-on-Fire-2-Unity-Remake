/* Remake: the lines (full width, no gaps) on a slightly see-through dark band (players' wish: not pure black); the tab and
   the input row stay solid. Over the flight HUD's key hints a hint can faintly show through. */

/* Placed and sized relative to the HUD (percentages), with a floor so a narrow window keeps a usable line. */
.chat {
    position: absolute;
    left: 1.5%;
    top: 36%;
    width: 30%;
    min-width: 440px;
    max-width: 760px;
}

/* the Chat button, the size of the station's Menu / Multiplayer buttons (.station-menu-button): tapped on a phone, B (the
   chat key) still opens it too */
.chat-tab {
    align-self: flex-start;
    min-height: 50px;
    min-width: 120px;
    padding: 12px 22px;
    margin: 0 0 8px 0;
    font-size: 20px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(216, 236, 247);
    background-color: rgba(4, 10, 18, 0.85);
    border-width: 2px;
    border-color: rgba(143, 216, 255, 0.5);
    border-radius: 4px;
}

.chat-tab:hover {
    background-color: rgba(24, 44, 60, 0.9);
    border-color: rgb(143, 216, 255);
}

.chat-tab:active {
    background-color: rgba(143, 216, 255, 0.3);
}

.chat-tab--open {
    border-color: rgb(143, 216, 255);
}

.chat-line {
    align-self: stretch;   /* the full width, no gaps: one block that covers the key hints under it */
    margin-bottom: 0;
    padding: 3px 8px;
    font-size: 17px;
    color: rgb(230, 240, 246);
    white-space: normal;
    background-color: rgba(4, 8, 14, 0.72);
    border-radius: 2px;
}

.chat-line--own {
    color: rgb(255, 255, 255);
}

.chat-line--notice {
    color: rgba(216, 236, 247, 0.65);
    -unity-font-style: italic;
}

.chat-input-row {
    display: none;
    flex-direction: row;
    margin-top: 6px;
}

.chat--open .chat-input-row {
    display: flex;
}

.chat-channel {
    min-width: 96px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin: 0;
    padding: 4px 10px;
    font-size: 14px;
    color: rgb(143, 216, 255);
    background-color: rgb(4, 8, 14);
    border-width: 1px;
    border-color: rgba(143, 216, 255, 0.5);
    border-radius: 2px;
}

.chat-channel--global {
    color: rgb(240, 179, 90);
    border-color: rgba(240, 179, 90, 0.5);
}

.chat-field {
    flex-grow: 1;
    margin: 0 0 0 6px;
}

/* The Send button after the line (touch, mouse; Enter sends too). */
.chat-send {
    min-width: 72px;
    margin-left: 6px;
    color: rgb(4, 10, 18);
    background-color: rgb(240, 179, 90);
    border-color: rgb(240, 179, 90);
}

.chat-field .unity-base-text-field__input {
    padding: 5px 10px;
    font-size: 17px;
    color: rgb(255, 255, 255);
    background-color: rgb(4, 8, 14);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.3);
    border-radius: 2px;
}

/* The close button at the end of the row (touch, mouse; Esc, B and Enter on an empty line close too). */
.chat-close {
    min-width: 44px;
    margin-left: 6px;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(216, 236, 247);
    border-color: rgba(216, 236, 247, 0.4);
}

/* Phones, typing: the chat at the top of the screen, clear of the on-screen keyboard (which covers the lower half in
   landscape; at 36 % the input row ended up under it). The Chat tab gives its room to the lines (the row's close button
   closes), and the "/" suggestions stay short so they never push the line down under the keyboard. */
.chat--phone.chat--open {
    top: 2%;
    width: 70%;
    max-width: none;
}

.chat-tab--phone-open {
    display: none;
}

.chat--phone .chat-suggest {
    max-height: 132px;
    overflow: hidden;
}

.chat--phone .chat-suggest-row {
    flex-shrink: 0;   /* cut off at the bottom, never squeezed into each other */
}

.chat--phone .chat-suggest-hint {
    display: none;   /* "Tab complete": no Tab key */
}

.chat--phone .chat-input-row {
    min-height: 44px;   /* finger-sized */
}

/* Typing "/": the matching commands over the input line (ChatView.RefreshSuggestions), Tab's pick highlighted. */
.chat-suggest {
    margin-top: 6px;
    background-color: rgb(4, 8, 14);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.3);
    border-radius: 2px;
}

.chat-suggest-row {
    padding: 4px 10px;
    font-size: 16px;
    color: rgb(230, 240, 246);
    white-space: normal;
}

.chat-suggest-row--picked {
    background-color: rgba(240, 179, 90, 0.25);
    border-left-width: 2px;
    border-left-color: rgb(240, 179, 90);
}

.chat-suggest-hint {
    padding: 3px 10px 4px 10px;
    font-size: 13px;
    color: rgba(216, 236, 247, 0.5);
}

/* The /netstats overlay (NetStats), top left between the HUD's bars and the chat. */
.netstats {
    position: absolute;
    left: 24px;
    top: 21%;
    padding: 6px 10px;
    font-size: 15px;
    color: rgb(216, 236, 247);
    background-color: rgba(4, 8, 14, 0.85);
    border-left-width: 2px;
    border-left-color: rgb(240, 179, 90);
    white-space: nowrap;
}

.netstats--station {
    left: auto;
    right: 24px;
    top: 9%;
}

/* Large (UiScale.Large: a small high-density screen such as a 5.5" handheld): everything about 1.5x, the buttons
   finger-sized (about 6 mm on the Retroid Pocket G2). */
.chat--large {
    width: 46%;
    max-width: none;
}

.chat-tab.chat-tab--large {
    min-height: 72px;
    min-width: 150px;
    padding: 8px 24px;
    margin-bottom: 8px;
    font-size: 24px;
}

.chat--large .chat-line {
    padding: 5px 12px;
    font-size: 25px;
}

.chat--large .chat-input-row {
    min-height: 76px;
    margin-top: 8px;
}

.chat--large .chat-channel {
    min-width: 140px;
    min-height: 76px;
    padding: 8px 16px;
    font-size: 22px;
}

.chat--large .chat-send {
    min-width: 140px;
}

.chat--large .chat-close {
    min-width: 84px;
    font-size: 34px;
}

.chat--large .chat-field .unity-base-text-field__input {
    padding: 10px 14px;
    font-size: 26px;
}

.chat--large .chat-suggest-row {
    padding: 8px 14px;
    font-size: 23px;
}

.chat--large.chat--phone .chat-suggest {
    max-height: 200px;
}

.chat--large .chat-suggest-hint {
    font-size: 18px;
}
