/* Main menu. Landscape only. Layout in reference pixels: the panel is always 1080 units tall (900 on phones),
   so its width varies with the aspect ratio. MainMenu adds layout-narrow (4:3, 16:10) and layout-phone to
   the root; on ultrawide screens the UI stays inside a centred 21:9 safe area. */

.menu-root {
    flex-grow: 1;
    align-items: center;
}

.safe-area {
    flex-grow: 1;
    width: 100%;
    max-width: 2560px;
}

/* ---- background shading over the 3D scene ------------------------------------------ */

.side-shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/shade_left.png");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0;
    transition-duration: 1.2s;
}

.bottom-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 22%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/shade_bottom.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.menu-root--menu .side-shade {
    opacity: 1;
}

/* Hover styles only apply while the root has can-hover (mouse in use). With touch MainMenu removes it,
   so a finger sliding over the UI doesn't light up everything it passes. */

/* ---- logo: top-left in the menu; MainMenu moves it to the centre for the title screen with
   translate + scale (transform-only, so the transition to the menu costs no layout per frame) ---- */

.logo {
    position: absolute;
    left: 3%;
    top: 6%;
    width: 26%;
    height: 16%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/logo_gof2_remake.png");
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: left;
    opacity: 0;
    transition-duration: 0.9s;
    transition-timing-function: ease-in-out-cubic;
}

.logo--instant {
    transition-duration: 0s;
}

.logo--title-visible {
    opacity: 1;
    transition-duration: 3.9s;
}

.logo--menu {
    opacity: 1;
}

.press-any-key {
    position: absolute;
    left: 0;
    right: 0;
    top: 62%;
    -unity-text-align: middle-center;
    font-size: 24px;
    letter-spacing: 6px;
    color: var(--gof-text);
    opacity: 0;
    transition-duration: 1s;
    transition-timing-function: ease-in-out-sine;
}

.press-any-key--on {
    opacity: 1;
}

.press-any-key--hidden {
    display: none;
}

/* ---- main column -------------------------------------------------------------------- */

.menu-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    display: none;
}

.menu-root--menu .menu-screen {
    display: flex;
}

.main-column {
    width: 30%;
    padding-left: 3%;
    padding-top: 13%;
    justify-content: center;
}

.main-buttons {
    margin-top: 48px;
}

/* Every row shown (Resume with a save and Debug with the debug tools on: eight rows): centred like the shorter list,
   Exit ended up over the version text at the bottom left (and its tap zone, .footer-version) and couldn't be pressed.
   The column starts higher and keeps the bottom 110 units free, the logo still clear above it. */
.main-column--full {
    padding-top: 10%;
    padding-bottom: 110px;
}

.main-column--full .main-buttons {
    margin-top: 16px;
}

/* the menu root prefix keeps the pressed state above the (can-hover) hover state */
.menu-root .menu-button:active {
    background-color: var(--gof-amber-soft);
}

.menu-button--hidden {
    opacity: 0;
    translate: -40px 0;
}

.menu-button--gone {
    display: none;
}

.main-buttons--revealing > .delay-1 { transition-delay: 0.05s; }
.main-buttons--revealing > .delay-2 { transition-delay: 0.1s; }
.main-buttons--revealing > .delay-3 { transition-delay: 0.15s; }
.main-buttons--revealing > .delay-4 { transition-delay: 0.2s; }
.main-buttons--revealing > .delay-5 { transition-delay: 0.25s; }
.main-buttons--revealing > .delay-6 { transition-delay: 0.3s; }
.main-buttons--revealing > .delay-7 { transition-delay: 0.35s; }
.main-buttons--revealing > .delay-8 { transition-delay: 0.4s; }
.main-buttons--revealing > .delay-9 { transition-delay: 0.45s; }

.main-column--dimmed .menu-button {
    opacity: 0.35;
}

/* ---- panels ------------------------------------------------------------------------- */

.panel-host {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    padding-left: 2%;
    padding-right: 6%;
    padding-top: 6%;
}

.panel {
    display: none;
    width: 100%;
    max-width: 820px;
    max-height: 80%;
    padding: 36px 44px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
    border-radius: 2px;
    opacity: 0;
    translate: 40px 0;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-cubic;
}

/* Options: wider than the other panels, so its six tabs fit on one line. */
#optionsPanel {
    max-width: 1000px;
}

.panel--wide {
    max-width: 1020px;
}

.panel--shown {
    display: flex;
}

.panel--visible {
    opacity: 1;
    translate: 0 0;
}

/* ---- debug panel (remake-only testing tools, F10 / five taps on the version text) ------- */

.debug-panel {
    max-width: 1400px;
    max-height: 88%;
}

.debug-columns {
    flex-direction: row;
    flex-shrink: 1;
    min-height: 0;
}

.debug-column--missions {
    width: 62%;
    flex-shrink: 0;
    margin-right: 3%;
}

.debug-column--cheats {
    width: 35%;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: flex-start;
}

.debug-column--cheats .option-item {
    flex-grow: 0;
    flex-shrink: 0;
}

.debug-column--cheats .unity-base-field__label {
    white-space: nowrap;
}

.debug-heading {
    margin-bottom: 8px;
    font-size: 18px;
    letter-spacing: 4px;
    color: var(--gof-cyan);
}

.debug-filter {
    margin: 0 0 10px 0;
}

.debug-filter .unity-base-text-field__input {
    padding: 8px 12px;
    font-size: 18px;
    color: var(--gof-text);
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.2);
    border-radius: 2px;
}

.debug-filter:focus .unity-base-text-field__input {
    border-color: var(--gof-amber);
}

.debug-mission-list {
    height: 540px;
}

.debug-mission-section {
    margin: 12px 0 4px 0;
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--gof-amber);
}

.debug-mission {
    flex-direction: column;
    align-items: stretch;
    margin: 0;
    padding: 7px 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-text-align: middle-left;
}

.debug-mission:focus,
.can-hover .debug-mission:hover {
    background-color: rgba(58, 170, 220, 0.14);
    border-left-color: var(--gof-amber);
}

.debug-mission-top {
    flex-direction: row;
    align-items: center;
}

.debug-mission-index {
    min-width: 46px;
    font-size: 17px;
    color: var(--gof-amber);
}

.debug-mission-title {
    flex-shrink: 1;
    font-size: 17px;
    color: var(--gof-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.debug-mission-station {
    margin-left: auto;
    padding-left: 12px;
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 14px;
    color: var(--gof-text-dim);
}

.debug-mission-summary {
    margin-left: 46px;
    font-size: 14px;
    color: var(--gof-text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.debug-option .unity-base-field__label {
    min-width: 290px;
}

/* ---- mod browser (remake, ModBrowser) ------------------------------------------------- */

.mods-panel {
    max-width: 1320px;
    height: 84%;
    max-height: 84%;
}

.mods-title-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.mods-count {
    font-size: 15px;
    color: var(--gof-text-dim);
}

.mods-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.mods-left {
    width: 42%;
    flex-shrink: 0;
    margin-right: 3%;
}

.mods-list {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.18);
}

.mods-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding: 24px;
    font-size: 17px;
    color: var(--gof-text-dim);
    white-space: normal;
}

.mods-row {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 8px 12px 8px 9px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.mods-row--selected {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-cyan);
}

.mods-row:focus,
.can-hover .mods-row:hover {
    background-color: rgba(58, 170, 220, 0.18);
    border-left-color: var(--gof-amber);
}

.mods-thumb {
    width: 112px;
    height: 63px;
    flex-shrink: 0;
    margin-right: 14px;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1px;
    border-color: var(--gof-line);
    -unity-background-scale-mode: scale-and-crop;
}

.mods-row--off .mods-thumb {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.55);
}

.mods-row-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mods-row-name {
    font-size: 19px;
    color: var(--gof-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mods-row--off .mods-row-name {
    color: var(--gof-text-dim);
}

.mods-row-sub {
    margin-top: 2px;
    font-size: 13px;
    color: var(--gof-text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mods-badge {
    flex-shrink: 0;
    margin-left: 10px;
    padding: 3px 9px;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--gof-text-dim);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.25);
    border-radius: 2px;
}

.mods-badge--on {
    color: #04121c;
    background-color: var(--gof-cyan);
    border-color: var(--gof-cyan);
}

.mods-badge--error {
    color: #ffffff;
    background-color: rgba(200, 50, 40, 0.85);
    border-color: rgb(230, 80, 60);
}

.mods-detail {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mods-preview {
    height: 300px;
    flex-shrink: 1;
    min-height: 120px;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1px;
    border-color: var(--gof-line);
    -unity-background-scale-mode: scale-and-crop;
}

.mods-preview--none {
    background-color: rgba(62, 200, 255, 0.06);
}

.mods-name {
    flex-shrink: 0;
    margin-top: 16px;
    font-size: 30px;
    color: var(--gof-text);
    white-space: normal;
}

.mods-meta {
    flex-shrink: 0;
    margin-top: 2px;
    font-size: 14px;
    color: var(--gof-text-dim);
    white-space: normal;
}

.mods-desc-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 40px;
    margin-top: 12px;
}

.mods-desc {
    font-size: 17px;
    color: var(--gof-text);
    white-space: normal;
}

.mods-problems {
    margin-top: 10px;
    font-size: 14px;
    color: rgb(255, 170, 120);
    white-space: normal;
}

.mods-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 14px;
}

.mods-action {
    margin: 0 10px 0 0;
    padding: 10px 18px;
    font-size: 17px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: var(--gof-text);
    background-color: var(--gof-cyan-faint);
    border-width: 1px;
    border-color: var(--gof-cyan-soft);
    border-radius: 2px;
    transition-duration: 0.18s;
}

.can-hover .mods-action:hover,
.mods-action:focus {
    color: #ffffff;
    border-color: var(--gof-amber);
    background-color: var(--gof-cyan-soft);
}

.mods-action:disabled {
    opacity: 0.35;
}

.mods-toggle {
    min-width: 190px;
    color: #04121c;
    background-color: var(--gof-cyan);
    border-color: var(--gof-cyan);
}

.mods-toggle--on {
    color: var(--gof-text);
    background-color: rgba(200, 50, 40, 0.35);
    border-color: rgba(230, 80, 60, 0.8);
}

.can-hover .mods-toggle:hover,
.mods-toggle:focus {
    color: #04121c;
    background-color: var(--gof-amber);
}

.input-gamepad .mods-toggle {
    padding-left: 44px;
    padding-right: 44px;
}

/* The controller's X on the Turn on / off button (MainMenu toggles the selected mod with it); only with a controller. */
.mods-pad-x {
    display: none;
    position: absolute;
    left: 8px;
    top: 50%;
    width: 26px;
    height: 26px;
    margin-top: -13px;
    border-radius: 13px;
    font-size: 15px;
    letter-spacing: 0;
    color: #0B1016;
    background-color: #3F8FE8;
    -unity-text-align: middle-center;
}

.input-gamepad .mods-pad-x {
    display: flex;
}

.mods-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 14px;
}

.mods-note {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 14px;
    font-size: 14px;
    color: var(--gof-text-dim);
    white-space: normal;
}

.mods-footer-button {
    flex-shrink: 0;
    font-size: 15px;
    padding: 8px 14px;
    white-space: nowrap;
}

/* ---- multiplayer --------------------------------------------------------------------- */

.mp-title-row {
    flex-direction: row;
    align-items: center;
}

.mp-badge {
    margin-left: 18px;
    padding: 3px 10px;
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--gof-amber);
    border-width: 1px;
    border-color: var(--gof-amber-soft);
    border-radius: 2px;
    background-color: rgba(255, 166, 48, 0.08);
}

.mp-intro {
    margin-bottom: 24px;
    font-size: 18px;
    color: var(--gof-text);
    white-space: normal;
}

.mp-label {
    margin-bottom: 6px;
    font-size: 14px;
    letter-spacing: 3px;
    color: var(--gof-text-dim);
}

.mp-name {
    max-width: 420px;
    margin-bottom: 26px;
}

.mp-cards {
    flex-direction: row;
}

.mp-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 18px;
    padding: 20px 22px;
    background-color: rgba(62, 200, 255, 0.05);
    border-width: 1px;
    border-color: var(--gof-line);
    border-radius: 2px;
}

.mp-card--last {
    margin-right: 0;
}

.mp-card-title {
    font-size: 21px;
    letter-spacing: 4px;
    color: var(--gof-cyan);
}

.mp-card-text {
    margin: 8px 0 16px 0;
    font-size: 15px;
    color: var(--gof-text-dim);
    white-space: normal;
}

/* the address row: same height in both cards, so the buttons line up */
.mp-card-fill {
    flex-grow: 1;
    justify-content: center;
    min-height: 58px;
    margin-bottom: 16px;
}

.mp-address-list {
    margin-bottom: 10px;
}

.mp-card-fill--empty {
    min-height: 0;
    margin-bottom: 0;
}

/* one address: the adapter's name, the address, "copied" after a tap */
.mp-address-row {
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    margin: 0 0 4px 0;
    padding: 6px 10px;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.12);
    border-radius: 2px;
    transition-duration: 0.15s;
}

.can-hover .mp-address-row:hover,
.mp-address-row:focus {
    border-color: var(--gof-amber);
    background-color: var(--gof-cyan-faint);
}

.mp-address-name {
    width: 96px;
    font-size: 14px;
    color: var(--gof-text-dim);
}

.mp-address-value {
    flex-grow: 1;
    font-size: 20px;
    letter-spacing: 1px;
    color: var(--gof-text);
}

.mp-address-copy {
    font-size: 13px;
    color: var(--gof-text-dim);
}

.mp-address-row--copied .mp-address-copy {
    color: var(--gof-amber);
}

/* the host card's password and the session size on one row */
.mp-host-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 0 12px 0;
}

/* The password takes what is left and shrinks (min-width 0): its placeholder's width pushed the player limit out of the
   card with the wider Serpentine font. */
.mp-host-row .mp-host-password {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 14px 0 0;
}

.mp-max-label {
    flex-shrink: 0;
    margin: 0 8px 0 0;
    white-space: nowrap;
}

.mp-max-players {
    flex-shrink: 0;
    width: 64px;
    margin: 0;
}

/* the host card's Debug menu switch (Off / Allowed), under the password row */
.mp-debug-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 0 8px 0;   /* four rows (Debug menu, Combat, World, Mods) and the Host button fit the card */
}

.mp-debug-label {
    flex-shrink: 0;
    min-width: 130px;
    margin: 0 14px 0 0;
    white-space: nowrap;
}

.mp-debug-segments {
    flex-grow: 1;
}

.mp-debug-segments .choice-segment {
    flex-basis: 0;
    min-height: 30px;
}

/* the panel: a fixed height, the server browser takes what the rest leaves */
.mp-panel {
    max-width: 1280px;
    height: 84%;
    max-height: 84%;
}

.mp-title-spacer {
    flex-grow: 1;
}

.mp-name-label {
    margin: 0 12px 0 0;
}

.mp-panel .mp-name {
    width: 300px;
    margin: 0;
}

.mp-panel .mp-intro {
    flex-shrink: 0;
    margin-bottom: 16px;
    font-size: 16px;
    color: var(--gof-text-dim);
}

.mp-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.mp-browser {
    flex-grow: 1.7;
}

.mp-host {
    flex-grow: 1;
}

.mp-card-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.mp-server-count {
    font-size: 13px;
    color: var(--gof-text-dim);
}

.mp-browser .mp-server-list {
    flex-grow: 1;
    min-height: 100px;
    max-height: none;
}

.mp-join-label {
    flex-shrink: 0;
    margin: 14px 0 6px 0;
}

.mp-join-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.mp-join-row .mp-address {
    flex-grow: 1.3;
    flex-basis: 0;
    margin: 0 8px 0 0;
}

.mp-join-row .mp-join-password {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px 0 0;
}

.mp-join-row .mp-join-button {
    padding: 8px 26px;
    font-size: 18px;
}

/* the host card's choice: Public / Invite only / Local network */
.mp-mode-row {
    flex-grow: 0;
    margin: 12px 0 0 0;
}

/* the join card: the server browser. Only the list gives way when the panel is short (everything else keeps its
   height, so nothing slides under the title). */
.mp-card-title,
.mp-card-text,
.mp-mode-row,
.mp-card .debug-filter,
.mp-action {
    flex-shrink: 0;
}

.mp-server-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 62px;
    max-height: 200px;
    margin: 10px 0 0 0;
    background-color: rgba(0, 0, 0, 0.18);
}

.mp-server-row {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 3px;
    padding: 6px 10px;
}

.mp-server-line {
    flex-direction: row;
    align-items: center;
}

.mp-server-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 17px;
    color: var(--gof-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mp-server-info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-top: 2px;
    font-size: 13px;
    color: var(--gof-text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mp-server-tag {
    flex-shrink: 0;
    margin-left: 8px;
    padding: 1px 6px;
    font-size: 11px;
    letter-spacing: 2px;
    white-space: nowrap;
    color: var(--gof-cyan);
    border-width: 1px;
    border-color: var(--gof-cyan-soft);
    border-radius: 2px;
}

.mp-server-tag--password {
    color: var(--gof-amber);
    border-color: var(--gof-amber-soft);
}

.mp-server-tag--mods {
    color: rgb(150, 230, 140);
    border-color: rgba(150, 230, 140, 0.45);
}

/* Players fight anywhere (NetGame.FreePvp) / only in arenas and faction sieges. */
.mp-server-tag--pvp {
    color: rgb(255, 110, 100);
    border-color: rgba(255, 110, 100, 0.5);
}

.mp-server-tag--pve {
    color: rgb(170, 190, 210);
    border-color: rgba(170, 190, 210, 0.4);
}

.mp-password {
    margin: 0 0 12px 0;
}

.mp-join-fill .mp-password {
    margin: 10px 0 0 0;
}

.mp-join-fill {
    flex-shrink: 0;
}

.mp-server-version {
    flex-shrink: 0;
    margin: 2px 0 0 12px;
    font-size: 13px;
    -unity-text-align: middle-right;
    color: var(--gof-text-dim);
    white-space: nowrap;
}

.mp-server-version--other {
    color: var(--gof-amber);
}

.mp-server-row--full .mp-server-name,
.mp-server-row--full .mp-server-info {
    color: var(--gof-text-dim);
}

.mp-server-row--full {
    opacity: 0.6;
}

.mp-server-empty {
    margin: 12px;
    font-size: 15px;
    color: var(--gof-text-dim);
    white-space: normal;
}

.mp-join-text {
    flex-shrink: 0;
    margin: 8px 0 6px 0;
}

.mp-join-fill {
    flex-grow: 0;
    min-height: 0;
    margin-bottom: 12px;
}

.mp-port-row {
    flex-direction: row;
    align-items: center;
}

.mp-port-label {
    margin: 0 12px 0 0;
}

.mp-port {
    width: 120px;
    margin: 0;
}

.mp-address {
    margin: 0;
}

.mp-action {
    margin: 0;
    padding: 12px 18px;
    font-size: 20px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    color: var(--gof-text);
    background-color: var(--gof-cyan-faint);
    border-width: 1px;
    border-color: var(--gof-cyan-soft);
    border-radius: 2px;
    transition-duration: 0.18s;
}

.can-hover .mp-action:hover,
.mp-action:focus {
    color: #FFFFFF;
    border-color: var(--gof-amber);
    background-color: var(--gof-cyan-soft);
}

.menu-root .mp-action:active {
    background-color: var(--gof-amber-soft);
}

.mp-status {
    min-height: 22px;
    margin: 18px 0 0 0;
    font-size: 16px;
    color: var(--gof-amber);
    white-space: normal;
}

.debug-note {
    margin-top: 10px;
    font-size: 15px;
    color: var(--gof-text-dim);
    white-space: normal;
}

.layout-phone .debug-mission-list {
    height: 420px;
}

/* ---- campaign cards ----------------------------------------------------------------- */

.card-row {
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;   /* the cards keep their height (the New Game+ toggle goes under them) */
}

.campaign-card {
    width: 290px;
    height: 448px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    scale: 1 1;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
}

.can-hover .campaign-card:hover,
.campaign-card:focus,
.campaign-card:active {
    scale: 1.05 1.05;
    border-color: var(--gof-amber);
}

.card-art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.2s;
}

.card-art-hover {
    opacity: 0;
}

.can-hover .campaign-card:hover > .card-art-hover,
.campaign-card:focus > .card-art-hover,
.campaign-card:active > .card-art-hover {
    opacity: 1;
}

.card-gof2 { background-image: url("project://database/Assets/UI/MainMenu/Images/card_gof2.png"); }
.card-gof2-hover { background-image: url("project://database/Assets/UI/MainMenu/Images/card_gof2_hover.png"); }
.card-valkyrie { background-image: url("project://database/Assets/UI/MainMenu/Images/card_valkyrie.png"); }
.card-valkyrie-hover { background-image: url("project://database/Assets/UI/MainMenu/Images/card_valkyrie_hover.png"); }
.card-supernova { background-image: url("project://database/Assets/UI/MainMenu/Images/card_supernova.png"); }
.card-supernova-hover { background-image: url("project://database/Assets/UI/MainMenu/Images/card_supernova_hover.png"); }

/* ---- difficulty --------------------------------------------------------------------- */

.choice-button {
    margin: 8px 0;
    padding: 18px 22px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: var(--gof-line);
    border-left-width: 3px;
    border-radius: 2px;
    align-items: stretch;
    transition-duration: 0.18s;
}

.can-hover .choice-button:hover,
.choice-button:focus,
.choice-button:active {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
    padding-left: 30px;   /* the content moves, not the box (a translated box slid away from the cursor) */
}

/* The new game's Kaamo Club expansion toggle (under the economy choices; a choice, not a start button). */
.choice-button--toggle {
    margin-top: 22px;
    flex-shrink: 0;
    border-left-color: var(--gof-line);
}

/* The game options panel holds four toggles (the Kaamo Club, Hardcore, Tutorials, Capital ships) and Start: tighter so it
   fits the panel's 80 % height. */
#gameOptionsPanel .choice-button--toggle {
    margin-top: 10px;
    margin-bottom: 0;
    padding: 11px 20px;
}

#gameOptionsPanel .choice-desc {
    margin-top: 3px;
    font-size: 15px;
}

.choice-button--toggle.choice-button--on {
    border-left-color: var(--gof-amber);
}

.choice-button--on .choice-title {
    color: var(--gof-amber);
}

.choice-title {
    font-size: 24px;
    letter-spacing: 4px;
    color: #FFFFFF;
    -unity-text-align: middle-left;
}

.choice-desc {
    margin-top: 6px;
    font-size: 17px;
    color: var(--gof-text-dim);
    white-space: normal;
    -unity-text-align: upper-left;
}

.choice-button--danger .choice-title {
    color: var(--gof-amber);
}

/* Start game: the Game options panel's one action, amber like the station's Launch (the toggles above it are choices). */
.choice-button--start {
    margin-top: 26px;
    flex-shrink: 0;
    align-items: center;
    background-color: rgba(255, 166, 48, 0.16);
    border-width: 2px;
    border-left-width: 2px;
    border-color: var(--gof-amber);
    border-radius: 4px;
}

.choice-button--start .choice-title {
    font-size: 28px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
}

.choice-button--start .choice-desc {
    color: rgba(255, 255, 255, 0.75);
    -unity-text-align: middle-center;
}

.can-hover .choice-button--start:hover,
.choice-button--start:focus,
.choice-button--start:active {
    background-color: rgba(255, 166, 48, 0.38);
    border-left-color: var(--gof-amber);
    padding-left: 22px;   /* centred: no slide like the choices */
    scale: 1.02 1.02;
}

/* ---- options ------------------------------------------------------------------------ */

.section-header {
    margin: 14px 0 4px 0;
    font-size: 15px;
    letter-spacing: 4px;
    color: var(--gof-amber);
}

.language-list {
    flex-direction: row;
    flex-wrap: wrap;
}

/* The voice language row under the text language buttons. */
.language-voice-row {
    margin-top: 28px;
}

.language-button {
    width: 46%;
    margin: 4px 8px 4px 0;
    font-size: 20px;
    letter-spacing: 1px;
}

.language-button--active {
    color: var(--gof-cyan);
    border-left-color: var(--gof-cyan);
}

/* ---- about -------------------------------------------------------------------------- */

.about-scroll {
    height: 520px;
    flex-shrink: 1;
    min-height: 120px;
}

.about-text {
    flex-shrink: 0;
    white-space: normal;
    font-size: 17px;
    color: var(--gof-text);
    -unity-text-align: upper-left;
}

/* ---- footer ------------------------------------------------------------------------- */

.footer {
    position: absolute;
    left: 3%;
    right: 3%;
    bottom: 3%;
    flex-direction: row;
    justify-content: space-between;
    opacity: 0;
    transition-duration: 0.8s;
}

.menu-root--menu .footer {
    opacity: 1;
}

/* Remake: "Update available" (UpdateCheck), bottom centre above the footer line (the credit line is wide enough to
   reach the centre on 4:3), shown in the menu while no panel is open. */
.update-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 72px;
    flex-direction: row;
    justify-content: center;
    display: none;
}

.update-row--shown {
    display: flex;
}

.update-button {
    background-color: rgba(4, 10, 18, 0.78);
    border-width: 1px;
    border-color: var(--gof-amber);
    border-radius: 0;
    margin: 0;
    padding: 10px 28px;
    -unity-text-align: middle-center;
    font-size: 18px;
    letter-spacing: 4px;
    color: var(--gof-amber);
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.update-button:focus,
.can-hover .update-button:hover {
    color: #FFFFFF;
    background-color: var(--gof-amber-soft);
}

.menu-root .update-button:active {
    background-color: var(--gof-amber);
    color: #000000;
}

.layout-phone .update-row {
    bottom: 60px;
}

.layout-phone .update-button {
    padding: 14px 32px;
}

.footer-text {
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--gof-text-dim);
}

/* The debug panel's tap target: padding widens the hit zone, the negative margin keeps the text where it was. */
.footer-version {
    padding: 40px 60px 40px 40px;
    margin: -40px -60px -40px -40px;
}

/* ---- dialog ------------------------------------------------------------------------- */

.dialog-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
    display: none;
}

.dialog-backdrop--shown {
    display: flex;
}

.dialog {
    width: 90%;
    max-width: 760px;
    padding: 36px 44px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.dialog-text {
    white-space: normal;
    font-size: 19px;
    color: var(--gof-text);
    margin-bottom: 26px;
    -unity-text-align: upper-left;
}

/* The pilot name prompt's field (MainMenu.NeedsName), hidden in the other dialogs. */
.dialog-field {
    display: none;
    margin: -8px 0 26px 0;
}

.dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.dialog-button {
    margin-left: 12px;
    font-size: 20px;
}

/* ---- splash + fade ------------------------------------------------------------------ */

.splash {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #000000;
    justify-content: center;
    align-items: center;
    transition-duration: 1s;
}

.splash--gone {
    opacity: 0;
}

.splash--removed {
    display: none;
}

.splash-logo {
    width: 34%;
    height: 44%;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
    scale: 0.96 0.96;
    transition-duration: 1s;
    transition-timing-function: ease-out-sine;
}

.splash-logo--visible {
    opacity: 1;
    scale: 1 1;
}

.fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #000000;
    opacity: 0;
    transition-duration: 1.2s;
}

.fade--on {
    opacity: 1;
}

/* ---- responsive layouts ------------------------------------------------------------- */

.layout-narrow .main-column {
    width: 36%;
}

.layout-narrow .panel-host {
    padding-right: 3%;
}

.layout-narrow .campaign-card {
    width: 230px;
    height: 356px;
}

.layout-phone .footer-hint {
    display: none;
}

.layout-phone .menu-button {
    padding: 16px 22px;
}

.layout-phone .panel-host {
    padding-top: 3%;
}

.layout-phone .panel {
    padding: 24px 34px;
    max-height: 90%;
}

.layout-phone .panel-accent {
    margin: 10px 0 16px 0;
}

.layout-phone .back-button {
    margin-top: 14px;
}

.layout-phone .mp-intro {
    margin-bottom: 14px;
}

.layout-phone .mp-name {
    margin-bottom: 14px;
}

.layout-phone .mp-card {
    padding: 14px 16px;
}

.layout-phone .mp-panel .mp-intro {
    display: none;
}

.layout-phone .mp-panel .mp-name {
    width: 220px;
}

.layout-phone .campaign-card {
    width: 238px;
    height: 368px;
}

/* Remake mods: the loading screen (ModLoadingView) on the startup splash and the fade before a game. */
.mod-loading {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16%;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.mod-loading--shown {
    opacity: 1;
}

.mod-loading__title {
    color: var(--gof-text);
    font-size: 30px;
    letter-spacing: 6px;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}

.mod-loading__track {
    width: 560px;
    max-width: 70%;
    height: 8px;
    background-color: var(--gof-cyan-faint);
    border-width: 1px;
    border-color: var(--gof-line);
}

.mod-loading__fill {
    height: 100%;
    width: 0;
    background-color: var(--gof-amber);
    transition-property: width;
    transition-duration: 0.15s;
}

.mod-loading__line {
    color: var(--gof-text-dim);
    font-size: 22px;
    margin-top: 14px;
    -unity-text-align: middle-center;
}

/* Remake mods: the mods' campaigns under the campaign cards (MainMenu.RefreshModCampaigns). */
.mod-campaigns {
    margin-top: 14px;
    flex-shrink: 0;
}

.mod-campaign {
    flex-direction: row;
    align-items: center;
}

.mod-campaign__image {
    width: 128px;
    height: 72px;
    margin-right: 16px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 3px;
}

.mod-campaign__text {
    flex-grow: 1;
    flex-shrink: 1;
}
