<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Dialogue" src="../Dialogue/Dialogue.uxml" />
    <ui:Style src="../GoF2InputGlyphs.uss" />
    <ui:Style src="FlightHud.uss" />
    <ui:Style src="../Station/HangarWindow.uss" />
    <ui:Style src="../Dialogue/Dialogue.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="mining" class="mining" picking-mode="Ignore" />
        <ui:VisualElement name="hitArcs" class="hit-arcs" picking-mode="Ignore">
            <ui:VisualElement name="arcLeft" class="hit-arc hit-arc--left" picking-mode="Ignore" />
            <ui:VisualElement name="arcRight" class="hit-arc hit-arc--right" picking-mode="Ignore" />
            <ui:VisualElement name="arcTop" class="hit-arc hit-arc--top" picking-mode="Ignore" />
            <ui:VisualElement name="arcBottom" class="hit-arc hit-arc--bottom" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="safeArea" class="hud-safe" picking-mode="Ignore">
            <ui:VisualElement name="radarEllipse" class="radar-ellipse" picking-mode="Ignore" />
            <ui:VisualElement name="combatMarkers" class="nav-markers" picking-mode="Ignore" />
            <ui:VisualElement name="navMarkers" class="nav-markers" picking-mode="Ignore" />
            <ui:VisualElement name="statusPanel" class="status-panel" picking-mode="Ignore">
                <ui:VisualElement name="shieldRow" class="status-row" picking-mode="Ignore">
                    <ui:VisualElement name="shieldIcon" class="status-icon" picking-mode="Ignore" />
                    <ui:VisualElement class="status-plate" picking-mode="Ignore">
                        <ui:VisualElement name="shieldFrame" class="status-bar" picking-mode="Ignore">
                            <ui:VisualElement name="shieldFill" class="status-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hullRow" class="status-row" picking-mode="Ignore">
                    <ui:VisualElement name="hullIcon" class="status-icon" picking-mode="Ignore" />
                    <ui:VisualElement class="status-plate" picking-mode="Ignore">
                        <ui:VisualElement name="hullFrame" class="status-bar" picking-mode="Ignore">
                            <ui:VisualElement name="hullFill" class="status-fill" picking-mode="Ignore" />
                            <ui:VisualElement name="armorFill" class="status-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="gammaRow" class="status-row" picking-mode="Ignore">
                    <ui:VisualElement name="gammaIcon" class="status-icon" picking-mode="Ignore" />
                    <ui:VisualElement class="status-plate" picking-mode="Ignore">
                        <ui:VisualElement name="gammaFrame" class="status-bar" picking-mode="Ignore">
                            <ui:VisualElement name="gammaFill" class="status-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore" />
            <ui:VisualElement name="lockRing" class="lock-ring" picking-mode="Ignore" />

            <!-- The touch controls (TouchControls builds them from the original images). -->
            <ui:VisualElement name="touchLayer" class="touch-layer" picking-mode="Ignore" />

            <ui:VisualElement name="dockPrompt" class="dock-prompt dock-prompt--hidden">
                <ui:VisualElement name="dockGlyph" class="dock-glyph" picking-mode="Ignore" />
                <ui:Label name="dockLabel" class="dock-label gof-semibold" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="navButtons" class="nav-buttons">
                <ui:VisualElement name="navButtonPill" class="nav-abs" picking-mode="Ignore" />
                <ui:VisualElement name="fastForwardButton" class="nav-button nav-button--ff" />
                <ui:VisualElement name="autopilotButton" class="nav-button nav-button--autopilot" />
            </ui:VisualElement>

            <ui:VisualElement name="autopilotMenu" class="autopilot-menu">
                <ui:VisualElement class="autopilot-menu-head" picking-mode="Ignore">
                    <ui:VisualElement name="autopilotMenuIcon" class="autopilot-menu-icon" picking-mode="Ignore" />
                    <ui:Label name="autopilotMenuTitle" class="autopilot-menu-title gof-semibold" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="autopilotMenuItems" class="autopilot-menu-items" />
            </ui:VisualElement>

            <ui:VisualElement name="lockPlate" class="lock-plate" picking-mode="Ignore">
                <ui:VisualElement name="lockClass" class="lock-class" picking-mode="Ignore" />
                <ui:Label name="lockOre" class="lock-ore gof-semibold" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="hudMessages" class="hud-messages" picking-mode="Ignore" />
            <ui:VisualElement name="jumpCharge" class="jump-charge" picking-mode="Ignore">
                <ui:VisualElement name="jumpChargeFill" class="jump-charge-fill" picking-mode="Ignore">
                    <ui:VisualElement name="jumpChargeStripes" class="jump-charge-stripes" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="jumpChargeLabel" class="jump-charge-label gof-semibold" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="orbitInfo" class="orbit-info" picking-mode="Ignore">
                <ui:VisualElement name="orbitLogo" class="orbit-logo" picking-mode="Ignore" />
                <ui:VisualElement class="orbit-text" picking-mode="Ignore">
                    <ui:Label name="orbitStation" class="orbit-line orbit-line--station gof-semibold" picking-mode="Ignore" />
                    <ui:Label name="orbitSystem" class="orbit-line" picking-mode="Ignore" />
                    <ui:Label name="orbitSecurity" class="orbit-line" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="speedPanel" class="speed-panel" picking-mode="Ignore" />

            <ui:VisualElement name="hints" class="hints" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="gameOver" class="game-over">
            <ui:Label name="gameOverTitle" class="game-over-title gof-semibold" picking-mode="Ignore" />
            <ui:Label name="gameOverText" class="game-over-text" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="screenFade" class="screen-fade" picking-mode="Ignore" />
        <ui:VisualElement name="radio" class="radio" picking-mode="Ignore">
            <ui:VisualElement class="radio-header" picking-mode="Ignore">
                <ui:Label name="radioSpeaker" class="radio-speaker gof-semibold" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="radio-body" picking-mode="Ignore">
                <ui:VisualElement name="radioPortrait" class="portrait" picking-mode="Ignore" />
                <ui:Label name="radioText" class="radio-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="Dialogue" name="storyDialogue" class="dialogue-instance" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
