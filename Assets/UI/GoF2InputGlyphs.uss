/* Input hints shared by the HUDs (InputGlyph): a hint row (glyphs + label), keyboard keycaps and controller buttons in
   the Xbox or the PlayStation style (PadGlyph, InputMode.Style: the controller last used or the option). */

/* The button hints option (Settings.InputHints). Specific enough to beat the HUDs' own ".input-keyboard .hints" /
   ".input-gamepad .station-hints" rules, which showed the hints again (the option did nothing in flight). */
.hints--off,
.input-keyboard .hints--off,
.input-gamepad .hints--off,
.input-touch .hints--off,
.input-keyboard .hints.hints--off,
.input-gamepad .hints.hints--off {
    display: none;
}

/* Modified: every hint's keys in a row of their own (hint-keys) with the label under them on one line, both centred, as in
   the hangar window; the box has a grey border. The label's own line spacing (capitals, nothing below the line) leaves
   more room under it than above the keys, so the bottom padding is that much smaller. */
.hint {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
    padding: 7px 12px 3px 12px;
    background-color: rgba(4, 10, 18, 0.5);
    border-width: 2px;
    border-color: rgba(150, 158, 166, 0.7);
    border-radius: 4px;
}

/* Modified: an "i" window's controls (OptionInfo: the star map, Inspect ship, Action Freeze, the shop): one a line, its
   keys then its label, no boxes. Here, not in GoF2Common.uss: the theme's rules lose to this sheet's own .hint. */
.hints-popup {
    flex-direction: column;
}

.hints-popup .hint {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin: 3px 0;
    padding: 2px 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.hints-popup .hint-keys {
    min-width: 150px;
    justify-content: flex-end;
    margin-right: 14px;
}

.hints-popup .hint-label {
    margin: 0;
    padding: 0;
    font-size: 17px;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.hint-keys {
    flex-direction: row;
    align-items: center;
}

.hint-label {
    font-size: 17px;
    letter-spacing: 2px;
    color: var(--gof-text-dim);
    margin: 3px 0 0 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.keycap {
    min-width: 34px;
    height: 34px;
    padding: 0 8px;
    margin: 0 2px;
    font-size: 16px;
    color: var(--gof-text);
    -unity-text-align: middle-center;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: rgba(216, 236, 247, 0.45);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.06);
}

.keycap--wide {
    min-width: 110px;
}

.pad-face {
    width: 36px;
    height: 36px;
    margin: 0 2px;
    border-radius: 18px;
    font-size: 18px;
    color: #0B1016;
    -unity-text-align: middle-center;
}

.pad-face--a {
    background-color: #6BC24A;
}

.pad-face--y {
    background-color: #F2C230;
}

.pad-face--b {
    background-color: #E5484D;
}

.pad-face--x {
    background-color: #3F8FE8;
}

/* PlayStation's face buttons: dark like the pad's own, the symbol drawn by PadGlyph in its colour (cross blue, circle red,
   square pink, triangle green). */
.pad-face--ps {
    background-color: rgb(16, 21, 28);
    border-width: 2px;
    border-color: rgba(216, 236, 247, 0.55);
}

.pad-stick {
    width: 40px;
    height: 40px;
    margin: 0 2px;
    border-radius: 20px;
    border-width: 3px;
    border-color: rgba(216, 236, 247, 0.6);
    font-size: 13px;
    color: var(--gof-text);
    -unity-text-align: middle-center;
}

.pad-trigger {
    min-width: 42px;
    height: 32px;
    padding: 0 6px;
    margin: 0 2px;
    border-radius: 6px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    background-color: rgba(216, 236, 247, 0.85);
    font-size: 14px;
    color: #0B1016;
    -unity-text-align: middle-center;
}

.pad-bumper {
    min-width: 40px;
    height: 26px;
    padding: 0 6px;
    margin: 0 2px;
    border-radius: 13px;
    background-color: rgba(216, 236, 247, 0.85);
    font-size: 13px;
    color: #0B1016;
    -unity-text-align: middle-center;
}

.pad-menu {
    height: 30px;
    padding: 0 10px;
    margin: 0 2px;
    border-radius: 15px;
    background-color: rgba(216, 236, 247, 0.85);
    font-size: 12px;
    letter-spacing: 1px;
    color: #0B1016;
    -unity-text-align: middle-center;
}

/* A button with glyphs before its text (InputGlyph.WithGlyphs): glyphs and label in a centred row. */
.glyph-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.glyph-button-label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.glyph-button-glyph {
    margin: 0 12px 0 0;
}
