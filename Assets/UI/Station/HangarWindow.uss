/* The station's Hangar window (HangarWindow): tabs Ship / Shop, the item list on the left, the selected row's
   details, trade arrows and action on the right, cargo load and credits in the footer. Shown while the station root
   has hangar-open; it then replaces the side panel and the launch button. */

.hangar-window {
    display: none;
    position: absolute;
    left: 48px;
    right: 40px;
    top: 110px;
    bottom: 96px;
    background-color: rgba(4, 10, 18, 0.92);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.hangar-open .hangar-window {
    display: flex;
}

.hangar-open .side-panel,
.hangar-open .launch-button,
.hangar-open .side-shade {
    display: none;
}

.hangar-open .station-hints {
    left: 48px;
    right: 40px;
    /* Modified: the strip under the window (its bottom: 96 px), the hints centred in it both ways (they sat right-aligned,
       34 px up). */
    bottom: 0;
    height: 96px;
    justify-content: center;
    align-items: center;
    width: auto;   /* the main view's set 1000 px would squeeze the hints between left and right */
    max-width: none;
    flex-wrap: nowrap;
}

/* Modified: in the hangar window each hint's label under its keys (StationMenu.Hint's hint-keys), on one line: side by
   side the eight hints left their labels a word wide, broken over two or three lines. Keys and label centred both ways;
   the label's own line spacing (capitals, nothing below the line) left more room under it than above the keys, so the
   box's bottom padding is that much smaller. */
.hangar-open .station-hints .hint {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 7px 12px 3px 12px;
    margin: 0 4px;   /* no top margin (GoF2InputGlyphs' 6 px): the row centres on the boxes themselves */
}

.hangar-open .station-hints .hint-label {
    margin: 3px 0 0 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

/* ---- tabs ---------------------------------------------------------------------------- */

.hangar-top {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px 0 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--gof-line);
}

.hangar-tab {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin: 0 6px 0 0;
    padding: 12px 28px;
    font-size: 24px;
    letter-spacing: 4px;
    color: var(--gof-text-dim);
}

.hangar-tab--active {
    color: #FFFFFF;
    border-bottom-color: var(--gof-amber);
}

.can-hover .hangar-tab:hover {
    color: #FFFFFF;
}

.hangar-top-spacer {
    flex-grow: 1;
}

.hangar-close {
    display: none;
    padding: 10px 20px;
    margin-bottom: 6px;
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--gof-text);
    background-color: rgba(4, 10, 18, 0.55);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
}

.input-touch .hangar-close,
.input-keyboard .hangar-close {
    display: flex;
}

.can-hover .hangar-close:hover {
    border-color: var(--gof-amber);
    color: #FFFFFF;
}

/* ---- list ---------------------------------------------------------------------------- */

.hangar-body {
    flex-grow: 1;
    flex-direction: row;
}

.hangar-list {
    width: 56%;
    border-right-width: 1px;
    border-right-color: var(--gof-line);
}

.hangar-list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-bottom: 12px;
    padding-right: 14px;   /* Remake: the rows clear of the scrollbar along the right edge (list-bar) */
}

/* Remake: a blueprint ingredient's amount in the blueprint ("BLUEPRINT" over "12 / 40 t") at the row's right edge. */
.row-bp-amount {
    flex-shrink: 0;
    margin-left: 8px;
    align-items: flex-end;
}

.row-bp-amount-label {
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--gof-text-dim);
}

.row-bp-amount-value {
    font-size: 22px;
    color: var(--gof-text);
}

/* Remake: the list's scrollbar (HangarWindow.UpdateListBar; Unity's own scrollers are hidden, GoF2Common): a slim track
   along the list's right edge and a handle to drag with the mouse. */
.list-bar {
    position: absolute;
    width: 12px;
}

.list-bar-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
}

.list-bar-thumb {
    position: absolute;
    left: 0;
    right: 0;
    min-height: 30px;
    background-color: rgba(62, 200, 255, 0.45);
    border-radius: 6px;
}

/* Remake: on phones a finger-wide touch area (the bar, transparent) around the same slim track and handle. */
.layout-phone .list-bar {
    width: 56px;
}

.layout-phone .list-bar-track,
.layout-phone .list-bar-thumb {
    left: 22px;
    right: 22px;
}

.can-hover .list-bar-thumb:hover,
.list-bar-thumb--dragging {
    background-color: var(--gof-cyan);
}

.list-header {
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--gof-cyan);
    padding: 16px 20px 6px 20px;
}

.list-row {
    flex-direction: row;
    align-items: center;
    height: 96px;
    margin: 2px 10px;
    padding: 0 16px 0 10px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.03);
}

/* remake: the Ship tab's hold items (not mounted): a sub-header and an outlined, dimmer row */
.list-header--sub {
    font-size: 16px;
    letter-spacing: 1px;
    color: var(--gof-amber);
    padding: 10px 20px 4px 34px;
}

/* remake: the Ship tab's mounted items: tinted, with a cyan edge (the hold's items below are outlined and dimmer) */
.list-row--mounted {
    background-color: rgba(62, 200, 255, 0.06);
    border-left-color: var(--gof-cyan);
}

.list-row--cargo {
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(255, 255, 255, 0.10);
    margin-left: 34px;
}

/* Remake: a shop row the player has in the hold: the description title's blue, in its place (no outline or indent). */
.list-row--owned {
    background-color: rgba(33, 152, 255, 0.12);
}

.list-row--cargo .row-icon {
    opacity: 0.75;
}

.can-hover .list-row:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.list-row--selected,
.can-hover .list-row--selected:hover {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
}

/* Remake: Autocomplete as a button centred in the list (no row look of its own): after the rows' hover / selected
   backgrounds, which drew the grey box around it. */
.list-row--autocomplete,
.list-row--autocomplete.list-row--selected,
.can-hover .list-row--autocomplete:hover,
.can-hover .list-row--autocomplete.list-row--selected:hover {
    height: auto;
    padding: 10px 0;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
}

.list-row--autocomplete .row-autocomplete {
    margin: 0;
    padding: 12px 28px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.list-row--selected .row-autocomplete {
    background-color: rgba(255, 166, 48, 0.38);
}

.list-row--autocomplete .row-autocomplete--expensive {
    color: #FF6B5E;
}


.row-icon {
    width: 148px;
    height: 72px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.row-texts {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 16px;
    overflow: hidden;
}

.row-name {
    font-size: 24px;
    color: var(--gof-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.row-name--empty {
    color: var(--gof-text-disabled);
}

.row-sub {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.row-sub-text {
    font-size: 19px;
    color: var(--gof-text-dim);
}

.row-badge {
    font-size: 15px;
    letter-spacing: 2px;
    padding: 1px 7px;
    margin-right: 8px;
    border-radius: 3px;
    color: #0B1016;
}

.row-badge--new {
    background-color: var(--gof-amber);
}

.row-badge--mounted {
    background-color: var(--gof-cyan);
}

/* remake: a Ship tab item that is in the hold, not mounted */
.row-badge--cargo {
    background-color: var(--gof-amber);
}

/* remake: a blueprint ingredient this station sells */
.row-badge--stock {
    background-color: #7FD86A;
}

.row-price {
    min-width: 170px;
    font-size: 24px;
    color: #FFFFFF;
    -unity-text-align: middle-right;
}

/* Remake: the price beside the name; a shop item's amounts at the row's edges (station left, ship right). */
.row-name-line {
    flex-direction: row;
    align-items: center;
}

.row-name-line .row-name {
    flex-shrink: 1;
}

.row-price-sep {
    flex-shrink: 0;
    margin-left: 12px;
    font-size: 22px;
    color: var(--gof-text-dim);
}

.row-price--inline {
    min-width: 0;
    flex-shrink: 0;
    margin-left: 12px;
    font-size: 22px;
    -unity-text-align: middle-left;
}

.row-qty {
    width: 76px;
    flex-shrink: 0;
    font-size: 22px;
    color: var(--gof-text);
}

.row-qty--station {
    margin-right: 6px;
    -unity-text-align: middle-left;
}

.row-qty--ship {
    margin-left: 6px;
    -unity-text-align: middle-right;
}

/* Remake: an ingredient's SOLD HERE | amount badge opens the shop on it. */
.can-hover .row-badge--link:hover {
    background-color: #A6F08F;
}

.row-sub--badges .row-badge {
    margin-left: 0;
    margin-right: 8px;
}

.row-sub--trailing .row-badge {
    margin-left: 8px;
    margin-right: 0;
}

.row-price--expensive {
    color: #FF6B5E;
}

/* ---- details ------------------------------------------------------------------------- */

.hangar-details {
    width: 44%;
    padding: 20px 24px 14px 24px;
}

.detail-head {
    flex-direction: row;
    align-items: center;
}

.detail-icon {
    width: 216px;
    height: 105px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Remake: a ship's stats (left) beside its 3D view (right, half the panel). */
.detail-preview-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 10px;
    flex-shrink: 0;
}

.detail-preview-side {
    width: 50%;
    flex-shrink: 0;
    align-self: stretch;
}

/* Remake: the space under a ship's view; its buttons centred in it both ways. */
.detail-action-area {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

/* Remake: the item window's hint in place of a ship's name and race, as a title bar like "Description". */
/* Remake: a ship's buy / use buttons centred under its view, as wide as their text (FitActions wraps the price). */
.detail-action--side {
    align-self: center;
    margin-top: 0;
    max-width: 100%;
    white-space: normal;
    -unity-text-align: middle-center;
}

.detail-preview-stats {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 16px;
}

/* Remake (#82): a ship's details turn it in 3D under the name (ShipPreview; a click opens the item window).
   Remake: opaque like the item window's box; its height follows its width (ShipPreview.KeepAspect). */
.detail-preview {
    height: 230px;
    flex-shrink: 0;
    background-color: rgb(4, 16, 32);
    border-width: 1px;
    border-color: rgba(33, 152, 255, 0.3);
    overflow: hidden;
}

.detail-preview .info-floor {
    top: 62px;
    height: 130px;
}

.layout-phone .detail-preview {
    height: 190px;
}

.layout-phone .detail-preview .info-floor {
    top: 48px;
    height: 110px;
}

.detail-titles {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 18px;
}

.detail-name {
    font-size: 30px;
    color: #FFFFFF;
    white-space: normal;
}

.detail-sub {
    margin-top: 4px;
    font-size: 21px;
    color: var(--gof-text-dim);
    white-space: normal;
}

.trade-box {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    padding: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
}

.trade-box--hidden {
    display: none;
}

.trade-side {
    width: 110px;
}

.trade-side--right {
    align-items: flex-end;
}

.trade-side-label {
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--gof-text-dim);
}

.trade-side-value {
    font-size: 28px;
    color: #FFFFFF;
}

/* remake: what of the item is mounted (a missile launcher's remaining ammo), under the hold's amount */
.trade-side-note {
    font-size: 15px;
    color: var(--gof-text-dim);
}

.trade-arrow {
    /* Remake: as wide as its text (was 116px; "COMPRAR" didn't fit). */
    height: 64px;
    padding: 0 18px;
    margin: 0 8px;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
    transition-duration: 0.1s;
}

/* Remake: a blueprint ingredient's sides as wide as their text (the fixed 110px broke "12 / 40 t" and ADD in two),
   up to half the box before they wrap. */
.trade-box--ingredient .trade-side {
    width: auto;
    max-width: 50%;
    flex-shrink: 0;
}

/* Remake: a blueprint ingredient's ADD, under the blueprint's amount (right side). */
.trade-arrow--under {
    height: 48px;
    margin: 8px 0 0 0;
}

.trade-arrow--buy {
    border-color: var(--gof-amber);
}

.can-hover .trade-arrow:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.trade-arrow--pressed,
.can-hover .trade-arrow--pressed:hover {
    background-color: var(--gof-amber-soft);
    scale: 0.95 0.95;
}

.trade-arrow--disabled {
    opacity: 0.3;
}

.trade-arrow-label {
    font-size: 21px;
    letter-spacing: 3px;
    color: #FFFFFF;
}

/* Remake: Sell all / Buy all (Store all / Take all in the Kaamo Club's storage) under the trade arrows. */
.trade-all-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.trade-all {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 0 0 8px;
    padding: 8px 6px;
    font-size: 17px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: #FFFFFF;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 2px;
}

/* Remake: USS has no first-child selector, so Sell all kept the 8px left margin and sat off to the right: the gap is split
   between the two by name instead. */
.trade-all--first,   /* the carrier shop's row */
#sellAllButton {
    margin-left: 0;
    margin-right: 4px;
}

#buyAllButton {
    margin-left: 4px;
}

/* Remake: the hold-to-confirm bar filling the button (HoldToConfirm). */
.trade-all-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgba(255, 166, 48, 0.35);
}

.trade-all--buy {
    border-color: var(--gof-amber);
}

.can-hover .trade-all:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.trade-all--disabled {
    opacity: 0.3;
}

/* With a controller: the trigger that does it (LT sell all, RT buy all) at the button's left edge. */
.trade-all-pad {
    display: none;
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    justify-content: center;
    letter-spacing: 0;
}

.input-gamepad .trade-all-pad {
    display: flex;
}

.input-gamepad .trade-all {
    padding-left: 52px;
}

.trade-price {
    flex-grow: 1;
    font-size: 28px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.trade-price--expensive {
    color: #FF6B5E;
}

.detail-action {
    margin: 14px 0 0 0;
    padding: 14px;
    font-size: 24px;
    letter-spacing: 4px;
    color: #FFFFFF;
    background-color: rgba(255, 166, 48, 0.16);
    border-width: 2px;
    border-color: var(--gof-amber);
    border-radius: 4px;
}

.can-hover .detail-action:hover {
    background-color: rgba(255, 166, 48, 0.38);
}

.detail-action:active {
    background-color: var(--gof-amber);
    color: #0B1016;
}

.detail-action--hidden {
    display: none;
}

/* The Kaamo Club storage's second row button (Sell, 330) under Use (332). */
.detail-action--secondary {
    margin-top: 8px;
    background-color: rgba(255, 74, 58, 0.12);
    border-color: #FF4A3A;
}

.can-hover .detail-action--secondary:hover {
    background-color: rgba(255, 74, 58, 0.34);
}

.detail-action--secondary:active {
    background-color: #FF4A3A;
}

.detail-action--disabled {
    opacity: 0.35;
}

.detail-scroll {
    flex-grow: 1;
    margin-top: 16px;
}

/* Remake: any other item's stats (left) beside its description (right), filling the panel's bottom. */
.detail-item-row {
    flex-grow: 1;
    flex-direction: row;
    margin-top: 16px;
}

.detail-item-stats {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 16px;
}

.detail-item-right {
    flex-grow: 1;
    flex-basis: 0;
}

.detail-scroll--side {
    flex-grow: 1;
    margin-top: 0;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.stat-label {
    font-size: 21px;
    color: var(--gof-text-dim);
}

.stat-value {
    font-size: 21px;
    color: var(--gof-text);
}

/* Remake (#62): a dealer / stored ship's stat compared with the ship flown (ItemInfo.ShipStatsCompared). */
.stat-compare {
    flex-direction: row;
    align-items: center;
}

.stat-arrow {
    width: 57px;
    height: 32px;
    margin-left: 8px;
    -unity-background-scale-mode: stretch-to-fill;
}

.detail-text {
    margin-top: 14px;
    font-size: 20px;
    color: var(--gof-text);
    white-space: normal;
}

/* Remake: the ship's Kaamo Club mods under its description (ItemInfo.FillModLines: hangar, carrier, item window). */
.kaamo-mods {
    margin-top: 14px;
    padding: 8px 12px;
    border-left-width: 3px;
    border-left-color: #FFA630;
    background-color: rgba(255, 166, 48, 0.08);
}

.kaamo-mod-line {
    font-size: 18px;
    color: #FFC872;
    white-space: normal;
}

/* ---- footer -------------------------------------------------------------------------- */

.hangar-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 22px;
    border-top-width: 1px;
    border-top-color: var(--gof-line);
}

/* Remake: the hold's load (left) and the credits (right) each in a box of their own, in the footer's corners on every tab. */
.footer-cargo,
.footer-credits {
    padding: 8px 18px;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.footer-cargo {
    font-size: 23px;
    letter-spacing: 1px;
    color: var(--gof-text);
}

.footer-cargo--over {
    color: #FF6B5E;
    border-color: #FF6B5E;
}

/* Remake: a multiplayer session's restock countdown, between the two (HangarWindow.UpdateRestock). */
.footer-restock {
    padding: 8px 18px;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-line);
    border-radius: 4px;
    -unity-text-align: middle-center;
    font-size: 21px;
    letter-spacing: 1px;
    color: var(--gof-text-dim);
}

.footer-credits {
    font-size: 25px;
    color: var(--gof-amber);
    border-color: var(--gof-amber);
}

/* ---- messages (sold, mounted, not enough credits ...) ------------------------------------ */

.station-toast {
    position: absolute;
    bottom: 52px;   /* under the windows (at the top it covered their header tabs), above the news ticker */
    left: 50%;
    translate: -50% 0;
    max-width: 900px;
    padding: 14px 26px;
    font-size: 22px;
    color: #FFFFFF;
    white-space: normal;
    background-color: var(--gof-panel);
    border-left-width: 3px;
    border-left-color: var(--gof-amber);
    opacity: 0;
    transition-duration: 0.25s;
}

.station-toast--shown {
    opacity: 1;
}

/* Phones: smaller rows. */
.layout-phone .row-icon {
    width: 124px;
    height: 60px;
}

.layout-phone .list-row {
    height: 86px;
}

/* ---- blueprints (HangarList::initBlueprintTab: progress bar, highlight while the hold helps) ---------------- */

.bp-bar {
    height: 6px;
    margin-top: 4px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
}

.bp-bar-fill {
    height: 100%;
    background-color: var(--gof-cyan);
}

.row-name--helps {
    color: #6BF06B;
}

/* ListItemWindow's info button (0x470 "i") on the selected row. */
.row-info {
    display: none;
    width: 44px;
    height: 44px;
    margin-left: 10px;
    border-radius: 22px;
    font-size: 22px;
    -unity-text-align: middle-center;
    padding: 0;
}

.list-row--selected .row-info {
    display: flex;
}

/* With a controller the info button shows the controller's Y instead of the "i" (StationMenu opens the details with
   it), like the hint row's glyph. */
.row-info-pad {
    display: none;
    position: absolute;
    left: 4px;
    top: 4px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    font-size: 18px;
    letter-spacing: 0;
    color: #0B1016;
    background-color: #F2C230;
    -unity-text-align: middle-center;
}

.input-gamepad .row-info-pad {
    display: flex;
}

.input-gamepad .row-info {
    color: rgba(0, 0, 0, 0);
}

/* ListItemWindow: the full-screen details (1300 x 800 box, full screen on phones). */
.info-backdrop {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.info-backdrop--shown {
    display: flex;
}

.info-box {
    width: 1300px;
    height: 800px;
    max-width: 100%;
    max-height: 100%;
    padding: 20px 28px 0 28px;
    background-color: rgb(4, 16, 32);
    border-width: 2px;
    border-color: rgba(33, 152, 255, 0.45);
    border-radius: 6px;
}

.layout-phone .info-box {
    width: 100%;
    height: 100%;
}

.info-header {
    font-size: 30px;
    letter-spacing: 3px;
    color: #FFFFFF;
}

.info-help {
    margin-bottom: 14px;
    font-size: 20px;
    white-space: normal;
    color: rgba(150, 200, 255, 0.7);
}

.info-columns {
    flex-grow: 1;
    flex-direction: row;
}

.info-left {
    width: 48%;
    margin-right: 2%;
}

.info-right {
    width: 50%;
}

.info-name-box {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    margin-bottom: 10px;
    background-color: rgba(33, 152, 255, 0.10);
    border-width: 1px;
    border-color: rgba(33, 152, 255, 0.3);
}

.info-icon {
    width: 180px;
    height: 88px;
    margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.info-name {
    font-size: 30px;
    color: #FFFFFF;
    white-space: normal;
}

.info-sub {
    font-size: 21px;
    color: rgba(150, 200, 255, 0.8);
}

.info-stats {
    flex-grow: 1;
}

.info-row {
    flex-direction: row;
    align-items: center;
    height: 46px;
    margin-bottom: 6px;
    padding: 0 10px;
    background-color: rgba(33, 152, 255, 0.07);
}

.info-row-label {
    flex-grow: 1;
    font-size: 22px;
    color: rgba(200, 225, 255, 0.85);
}

.info-row-value {
    font-size: 22px;
    color: #FFFFFF;
}

.info-row-arrow {
    width: 82px;
    height: 46px;
    margin-left: 8px;
    -unity-background-scale-mode: stretch-to-fill;
}

.info-preview {
    height: 318px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgba(33, 152, 255, 0.3);
    overflow: hidden;
}

.info-floor {
    position: absolute;
    width: 50%;
    height: 160px;
    left: 0;
    top: 99px;
    -unity-background-scale-mode: stretch-to-fill;
}

.info-floor--mirrored {
    left: 50%;
    scale: -1 1;
}

.info-preview-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.info-desc-title {
    font-size: 22px;
    letter-spacing: 2px;
    padding: 6px 10px;
    color: #FFFFFF;
    background-color: rgba(33, 152, 255, 0.12);
}

.info-text-scroll {
    flex-grow: 1;
    margin-top: 6px;
}

/* Remake: the ship alone in the box (ItemInfoWindow.ShowShipView, a click on the hangar details' view). */
.info-box--view .info-header,
.info-box--view .info-help,
.info-box--view .info-left,
.info-box--view .info-desc-title,
.info-box--view .info-text-scroll {
    display: none;
}

.info-box--view .info-right {
    width: 100%;
}

.info-box--view .info-preview {
    flex-grow: 1;
    height: auto;
    margin-bottom: 0;
}

/* Remake: on phones the ship view keeps the desktop's 1300 x 800 box (the details box goes full screen there for its
   text columns; the ship alone filled the whole screen and looked oversized). */
.layout-phone .info-box--view {
    width: 1300px;
    height: 800px;
}

/* Remake: the hangar details' description title, under a ship's view: a section header like the list's (.list-header:
   cyan, spaced capitals, no fill) over a thin line, not the item window's filled title bar. */
.detail-desc-title {
    margin-top: 4px;
    padding: 10px 0 6px 0;
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--gof-cyan);
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: var(--gof-line);
}

.info-text {
    font-size: 21px;
    white-space: normal;
    color: rgba(220, 235, 255, 0.9);
}

.info-footer {
    height: 74px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
}

.info-back {
    /* Remake: as wide and tall as its text (was min-width 220px, height 54px). */
    font-size: 24px;
    /* Remake: drawn like the hangar's close button (outline, amber on hover). */
    padding: 10px 20px;
    letter-spacing: 3px;
    color: var(--gof-text);
    background-color: rgba(4, 10, 18, 0.55);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
}

.can-hover .info-back:hover {
    border-color: var(--gof-amber);
    color: #FFFFFF;
}
