.timeline {
    width: 100%;
    min-height: 148px;
}

.timeline--grow {
    flex-grow: 1;
}

.timeline__loader {
    height: 30px;
    padding: 5px 20px;
    width: 100%;
}

.timeline__frame-selector {
    /* Ruler band (14) + diff tracker (28) + snapshot band (14) + breathing room. */
    height: 58px;
    width: 100%;
    border-width: 1px;
    border-right-width: 5px;
    border-left-width: 0;
    border-bottom-width: 0;
    border-color: var(--unity-colors-default-border);
}

.timeline__frame-selector__background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.timeline__frame-selector .timeline__frame-selector__background {
    top: 14px;
    bottom: auto;
    height: 28px;
}

.timeline__frame-selector .unity-base-slider__dragger {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    height: 56px;
    margin: 0;
    position: absolute;
}

.timeline__frame-selector .unity-base-slider__dragger-border {
    display: none;
}

.timeline__frame-selector__dragger-pin {
    background-image: var(--slider-dragger-icon);
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% 0;
    width: 10px;
    height: 56px;
}

.timeline__frame-selector .unity-base-slider__drag-container {
    background-color: var(--unity-colors-alternated_rows-background);

}

.timeline__frame-selector .unity-base-slider__tracker {
    background-color: var(--unity-colors-default-background);
    border-color: var(--unity-colors-default-border);
    border-width: 1px;
    top: 0;
    height: 28px;
    margin: 14px 0 0 0;
}

.timeline__frame-selector .unity-progress-bar__progress {
    background-color: yellow;
    height: 50px;
    width: 20px;
}

.timeline__frame-selector__container {
    min-height: 88px;
    flex-direction: row;
    width: 100%;
    border-color: var(--unity-colors-default-border);
    border-bottom-width: 1px;
}

.timeline__frame-selector .unity-slider-int__label {
    -unity-paragraph-spacing: 20px;
    -unity-text-align: middle-left;
    align-content: center;
    background-color: var(--unity-colors-window-background);
    border-color: var(--unity-colors-default-border);
    border-width: 1px;
    justify-content: space-evenly;
    max-width: 135px;
    width: 100%;
    white-space: normal;
}

.timeline__frame-selector__slider-container {
    flex-grow: 1;
}

/* The Highlights label sits at the top of the label column, level with the highlights range bar. */
.timeline__frame-selector__label-container {
    justify-content: flex-start;
    max-width: 119px;
    width: 100%;
    padding: 4px 4px 4px 6px;
    border-color: var(--unity-colors-default-border);
    border-right-width: 1px;
}

.timeline__highlights-label {
    height: 18px;
    -unity-text-align: middle-left;
}

/* Gutter label for the frame slider band, centered on the remaining column height. */
.timeline__frame-view-label {
    flex-grow: 1;
    -unity-text-align: middle-left;
    color: var(--timeline-gutter-label-color);
    font-size: 12px;
}

.timeline__frame-selector__ruler {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 14px;
}

.timeline__frame-selector__ruler-line {
    background-color: var(--timeline-ruler-line-color);
    bottom: 0;
    height: 5px;
    position: absolute;
    width: 1px;
}

.timeline__frame-selector__ruler-line--tall {
    height: 10px;
}

/* Profiler-style tag chips naming the ruler and snapshot bands, pinned at their left edge. */
.timeline__frame-selector__band-tag {
    position: absolute;
    left: 0;
    height: 14px;
    margin: 0;
    padding: 0 5px;
    font-size: 10px;
    -unity-text-align: middle-center;
    color: var(--timeline-band-tag-text);
    background-color: var(--timeline-band-tag-background);
    border-radius: 2px;
}

.timeline__frame-selector__ruler-tag {
    bottom: 0;
}

.timeline__frame-selector__snapshot-tag {
    top: 0;
}

.timeline__frame-selector__snapshot-band {
    position: absolute;
    left: 0;
    right: 0;
    top: 42px;
    height: 14px;
}

.timeline__frame-selector__snapshot-marker {
    background-image: var(--timeline-snapshot-marker-icon);
    top: -1px;
    height: 16px;
    position: absolute;
    translate: -50% 0;
    width: 16px;
}

.timeline__frame-selector__snapshot-marker--selected {
    background-image: var(--timeline-snapshot-marker-icon-selected);
}

.timeline__frame-selector__frame-marker {
    background-color: var(--tick-marker);
    height: 100%;
    position: absolute;
    width: 1px;
}

.timeline__frame-selector__replay-indicator {
    background-color: var(--timeline-replay-indicator-color);
    top: 14px;
    height: 28px;
    position: absolute;
    translate: -50% 0;
    width: 4px;
}

.timeline__frame-selector__frame-marker--inactive {
    background-color: var(--tick-marker-inactive);
}

.timeline__tick-selector__container {
    height: 60px;
    flex-direction: row;
    width: 100%;
    padding: 16px 0 0 0;
    background-color: var(--unity-colors-default-background);
}

.timeline__tick-selector__label {
    justify-content: center;
    max-width: 120px;
    padding-left: 6px;
    padding-right: 0;
    padding-bottom: 16px;
    width: 100%;
    flex-shrink: 0;
}

.timeline__tick-selector__scroll {
    flex-grow: 1;
    min-width: 0;
}

.timeline__tick-selector__scroll .unity-scroll-view__content-container {
    min-width: 100%;
    height: 28px;
    flex-direction: row;
}

.timeline__tick-selector__label .unity-label {
    padding-top: 1px;
    padding-bottom: 1px;
    -unity-text-align: middle-left;
}

.timeline__tick-selector__button-group-container {
    flex-grow: 1;
    padding-left: 0;
    margin-left: 0;
}

.timeline__tick-selector__button-group-button {
    flex-grow: 1;
    flex-shrink: 0;
    margin-left: 0;
    height: 28px;
    color: var(--label-on-tick);
}

.timeline__tick-selector__button-group-button--diff {
    background-image: var(--tick-background);
    background-size: 100% 100%;
    background-position-x: center;
    color: var(--label-on-red);
}

.timeline__tick-selector--selected {
    border-width: 2px;
    border-color: var(--selected-tick);
}

.timeline__range-selector {
    padding: 6px 0;
}

.timeline__range-selector .unity-min-max-slider__tracker {
    background-color: var(--unity-colors-default-background);
    border-color: var(--unity-colors-default-border);
    border-width: 1px;
    height: 10px;
    display: none;
}

.timeline__range-selector .unity-min-max-slider__dragger {
    background-color: transparent;
    border-color: white;
    border-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    margin-top: -2px;
    height: 12px;
}

.timeline__range-selector .unity-min-max-slider__min-thumb {
    background-color: transparent;
    border-radius: 0;
    border-color: white;
    border-width: 1px;
    border-right-width: 0;
    height: 12px;
}


.timeline__range-selector .unity-min-max-slider__max-thumb {
    background-color: transparent;
    border-radius: 0;
    border-color: white;
    border-width: 1px;
    border-left-width: 0;
    height: 12px;
}

.timeline__range-selector .unity-base-slider__drag-container {
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-alternated_rows-background);
}

.timeline__range-selector .unity-min-max-slider__input {
    background-color: var(--unity-colors-default-background);
    border-color: var(--unity-colors-default-border);
    border-width: 1px;
    height: 12px;
    max-height: 10px;
    min-height: 10px;
}


.timeline__loading-spinner-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.timeline__loading-spinner {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}
